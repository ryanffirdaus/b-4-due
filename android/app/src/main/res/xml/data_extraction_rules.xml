<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: cloud backup (the user's Google Drive) and device-to-device
  transfer when setting up a new phone. Same scope as backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="b4due.sqlite" />
        <include domain="file" path="b4due.sqlite-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="b4due.sqlite" />
        <include domain="file" path="b4due.sqlite-wal" />
    </device-transfer>
</data-extraction-rules>
